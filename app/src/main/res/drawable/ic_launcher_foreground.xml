<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="0"
        android:translateY="0">
        
        <!-- Outer Glowing Shield Shadow / Aura -->
        <path
            android:pathData="M54,23 L79,31.5 C79,53 69,72 54,85 C39,72 29,53 29,31.5 Z"
            android:fillColor="#0D2B4A" />

        <!-- Security Shield Rim (Golden Gradient Border) -->
        <path
            android:pathData="M54,25 L77,33 C77,52 68,70 54,82 C40,70 31,52 31,33 Z"
            android:strokeColor="#FFC107"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#10253E" />

        <!-- Inner Metallic Shield Contour -->
        <path
            android:pathData="M54,28.5 L73.5,35.5 C73.5,50 65.5,65 54,77 C42.5,65 34.5,50 34.5,35.5 Z"
            android:strokeColor="#FFE082"
            android:strokeWidth="1.2"
            android:fillColor="#0B1A2E" />

        <!-- Smartphone Silhouette in Top Section -->
        <path
            android:pathData="M46,31 C46,30 47,29 48,29 L60,29 C61,29 62,30 62,31 L62,45 C62,46 61,47 60,47 L48,47 C47,47 46,46 46,45 Z"
            android:strokeColor="#64B5F6"
            android:strokeWidth="1.5"
            android:fillColor="#153250" />
        
        <!-- Camera Dot & Home line on phone -->
        <path
            android:pathData="M52,31 L56,31"
            android:strokeColor="#90CAF9"
            android:strokeWidth="1"
            android:strokeLineCap="round" />
        
        <!-- Green Security Checkmark on Phone Screen -->
        <path
            android:pathData="M50.5,38 L53,40.5 L58,35.5"
            android:strokeColor="#00E676"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Horizontal Gold Ribbon/Plinth under phone for the text -->
        <path
            android:pathData="M37,48.5 L71,48.5"
            android:strokeColor="#FFB300"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />

        <!-- ============================================== -->
        <!-- ARABIC TEXT: "أمان" (Aman) IN BOLD CALLIGRAPHY -->
        <!-- Right to Left: أ (right), م (mid-right), ا (mid-left), ن (left) -->
        <!-- ============================================== -->

        <!-- 1) Right: Letter Alif with Hamza (أ) -->
        <!-- Vertical Alif Stem -->
        <path
            android:pathData="M68,52 L68,68"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- Hamza above Alif -->
        <path
            android:pathData="M65.5,50 C66.5,48.5 69.5,48.5 70.5,50 C70.5,51.5 68.5,52.2 66.5,52.8 L70.5,52.8"
            android:strokeColor="#FFD54F"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- 2) Mid-Right: Letter Meem (م) -->
        <!-- Triangular / Oval loop of Meem -->
        <path
            android:pathData="M62.5,63.5 C62.5,60 57,60 57,63.5 C57,66.8 62.5,66.8 62.5,63.5 Z"
            android:fillColor="#FFFFFF" />
        <!-- Base link connecting to next letter -->
        <path
            android:pathData="M62.5,64.5 L53.5,64.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- 3) Mid-Left: Connected Alif (ـا) -->
        <path
            android:pathData="M53.5,64.5 L53.5,52"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- 4) Left: Letter Noon (ن) -->
        <!-- Sweeping crescent bowl of Noon -->
        <path
            android:pathData="M50,64.5 L46,64.5 C40,64.5 37,64.5 37,68.5 C37,73 43.5,73 46.5,73 C49.5,73 50.5,71 50.5,68"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.0"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- Diamond dot above Noon -->
        <path
            android:pathData="M43.5,60.5 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
            android:fillColor="#FFD54F" />

        <!-- Small Golden Shield Star at the Bottom Tip -->
        <path
            android:pathData="M54,77 L54.7,78.5 L56.3,78.7 L55.1,79.8 L55.4,81.4 L54,80.6 L52.6,81.4 L52.9,79.8 L51.7,78.7 L53.3,78.5 Z"
            android:fillColor="#FFC107" />

    </group>
</vector>
