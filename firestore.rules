rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isAuthenticated()
        && ('email' in request.auth.token)
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    // Super admin is hard-wired and must have a verified email (Google Sign-In).
    function isSuperAdmin() {
      return hasVerifiedEmail()
        && request.auth.token.email == 'hashem7droid23@gmail.com';
    }

    // Secondary admin configured by the super admin in config/config.adminEmail
    function isConfiguredAdmin() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/config/config)
        && get(/databases/$(database)/documents/config/config).data.adminEmail == request.auth.token.email;
    }

    function isAdmin() {
      return isSuperAdmin() || isConfiguredAdmin();
    }

    function isValidReport(data) {
      return data.keys().hasOnly([
               'userId', 'reportType', 'brand', 'model', 'imei1', 'imei2', 'serialNumber',
               'color', 'distinctiveMarks', 'governorate', 'district', 'incidentLocation',
               'contactName', 'primaryPhone', 'whatsappNumber', 'rewardAmount',
               'policeReportNumber', 'isRecovered', 'additionalNotes', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.reportType in ['STOLEN', 'LOST', 'FOUND'] &&
             data.brand is string && data.brand.size() >= 2 && data.brand.size() <= 50 &&
             data.model is string && data.model.size() >= 2 && data.model.size() <= 100 &&
             data.imei1 is string && data.imei1.size() >= 8 && data.imei1.size() <= 20 &&
             data.governorate is string && data.governorate.size() >= 2 && data.governorate.size() <= 60 &&
             data.incidentLocation is string && data.incidentLocation.size() >= 2 && data.incidentLocation.size() <= 300 &&
             data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 100 &&
             data.primaryPhone is string && data.primaryPhone.size() >= 6 && data.primaryPhone.size() <= 20 &&
             data.isRecovered is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('additionalNotes' in data) || (data.additionalNotes is string && data.additionalNotes.size() <= 2000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('rewardAmount' in data) || (data.rewardAmount is int && data.rewardAmount >= 0));
    }

    function isValidAlert(data) {
      return data.keys().hasOnly([
               'authorId', 'reportId', 'title', 'message', 'governorate',
               'deviceModel', 'imeiSnippet', 'alertType', 'timestamp'
             ]) &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 500 &&
             data.governorate is string && data.governorate.size() <= 60 &&
             data.alertType is string &&
             data.timestamp is timestamp && data.timestamp <= request.time;
    }

    // A normal user may only broadcast an alert that points to a report they own.
    function isAlertForOwnReport(data) {
      return data.alertType in ['URGENT_THEFT', 'COMMUNITY_ALERT', 'DEVICE_FOUND', 'RECOVERY'] &&
             data.reportId is string && data.reportId.size() > 0 &&
             exists(/databases/$(database)/documents/reports/$(data.reportId)) &&
             get(/databases/$(database)/documents/reports/$(data.reportId)).data.userId == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Reports: authenticated citizens and shops can read to search IMEI / find devices
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        isValidReport(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt
      );
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Broadcast Alerts: only report owners (for their own report) or admins can publish
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAlert(request.resource.data) &&
                    (isAdmin() || isAlertForOwnReport(request.resource.data));
      allow update: if isAdmin() ||
                    (isOwner(resource.data.authorId) && isValidAlert(request.resource.data) &&
                     request.resource.data.alertType == resource.data.alertType &&
                     request.resource.data.reportId == resource.data.reportId);
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // User Profiles: private to the owner (and admins)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // System Config: readable by the app, writable by the super admin only
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
